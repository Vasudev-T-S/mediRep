# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_VERSION=0.1.0
SECRET_KEY=change-me-in-production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (dev default) – switch to postgresql+psycopg2://... for prod
DATABASE_URL=sqlite+aiosqlite:///./medirep.db

# ── Pipeline ─────────────────────────────────────────────────────────────────
# ner   → local biomedical entity extraction from TXT reports
# mock  → canned sample data for UI/tests
PIPELINE_MODE=ner
NER_MODEL_NAME=d4data/biomedical-ner-all

# ── LLM provider ─────────────────────────────────────────────────────────────
# mock | ollama | openai_compat | gemini
LLM_PROVIDER=mock

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=medgemma:4b

# OpenAI-compatible endpoint (vLLM, llama.cpp, Kaggle tunnel, etc.)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Gemini (dev fallback only – do NOT send real patient data here)
GEMINI_API_KEY=

# ── File upload limits ────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760    # 10 MB

# ── Result retention ─────────────────────────────────────────────────────────
RESULT_TTL_HOURS=24

# ── RAG / FAISS ───────────────────────────────────────────────────────────────
FAISS_INDEX_PATH=./kb/faiss.index
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
